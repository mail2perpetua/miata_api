# [ENV] DEVELOPMENT -----------------------------
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_SSL=false
LIVE_DB_NAME=miata_live_db

JWT_SECRET=replace_with_a_secure_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_REFRESH_TTL_HOURS=12
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=1024
MAX_DOCUMENT_SIZE_MB=20

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ENQUIRY_NOTIFY_EMAIL=

APP_TIMEZONE=Australia/Melbourne
ACCESS_EXPIRY_CHECK_MINUTES=60
